function curL() { return mode === 'fim' ? reviewing : (mode === 'lance' && S ? S.lance : null); }
function canScrub(L) { return !!(L && L.rig && (L.review || L.seen)); }
let dragging = false;
function syncScrub() {
  const L = curL(); if (!L || !L.rig) return;
  const on = canScrub(L), dur = lanceDur(L);
  ['scPlay', 'scBack', 'scFwd', 'scKey', 'scSpeed', 'scRange'].forEach(id => $(id).disabled = !on);
  if (!dragging) $('scRange').value = String(Math.round(clamp(L.time / dur, 0, 1) * 1000));
  const playing = !L.paused;
  $('scPlay').textContent = playing ? '❚❚' : '▶'; $('scPlay').setAttribute('aria-label', playing ? 'Pausa' : 'Reproduzir');
  $('scSpeed').textContent = (L.speed === 1 ? '1' : String(L.speed).replace('.', ',')) + 'x';
  const dk = Math.min(L.time, dur) - keyTime(L);
  $('scTime').textContent = (dk >= 0 ? '+' : '−') + Math.abs(dk).toFixed(2).replace('.', ',') + ' s';
}
function scrubTo(tm) { const L = curL(); if (!canScrub(L)) return; L.paused = true; L.time = clamp(tm, 0, lanceDur(L)); L.cam = null; syncScrub(); }
function togglePlay() {
  const L = curL(); if (!canScrub(L)) return;
  if (L.paused && L.time >= lanceDur(L) - 1e-3) { L.time = 0; L.cam = null; }
  L.paused = !L.paused; syncScrub();
}
function stepFrame(n) { const L = curL(); if (L) scrubTo(L.time + n / 30); }
function replay() {
  const L = S && S.lance;
  if (mode !== 'lance' || !L || !L.seen) return;
  L.replays++; L.time = 0; L.cam = null; L.speed = 0.4; L.paused = false; syncScrub();
}
$('replayBtn').addEventListener('click', replay);
$('scPlay').addEventListener('click', togglePlay);
$('scBack').addEventListener('click', () => stepFrame(-1));
$('scFwd').addEventListener('click', () => stepFrame(1));
$('scKey').addEventListener('click', () => { const L = curL(); if (L) scrubTo(keyTime(L)); });
$('scSpeed').addEventListener('click', () => { const L = curL(); if (!canScrub(L)) return; L.speed = L.speed === 1 ? 0.5 : L.speed === 0.5 ? 0.25 : 1; syncScrub(); });
$('scRange').addEventListener('input', e => { const L = curL(); if (L) { dragging = true; scrubTo(Number(e.target.value) / 1000 * lanceDur(L)); dragging = false; } });
$('scrub').addEventListener('pointerdown', e => e.stopPropagation());
