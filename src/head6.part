<title>Árbitro de Caricas</title>
<meta name="theme-color" content="#0e1712">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap">
<style>
/* Layout: estádio à noite; placar no topo, relvado ao centro, apito (decisões) em baixo. Um só visual, escuro de propósito. */
:root {
  --night: #0e1712;
  --panel: #16231b;
  --line: #2a3d30;
  --chalk: #eef0e6;
  --muted: #9db3a3;
  --whistle: #f2cf3a;
  --blue: #3569dc;
  --orange: #ee7d2c;
  --bad: #e5533d;
  --good: #58c27d;
  --display: "Barlow Condensed", "Arial Narrow", system-ui, sans-serif;
  --body: "Barlow", system-ui, -apple-system, "Segoe UI", sans-serif;
  color-scheme: dark;
}
[hidden] { display: none !important; }
html, body { background: var(--night); color: var(--chalk); }
body { font-family: var(--body); font-size: 15px; line-height: 1.45; }
.wrap { max-width: 1080px; margin: 0 auto; padding-inline: 16px; padding-block: 16px 32px; display: grid; gap: 12px; }
button { font: inherit; color: inherit; cursor: pointer; }
button:focus-visible { outline: 2px solid var(--whistle); outline-offset: 2px; }

.hud { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 12px; }
.team { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 600; font-size: 20px; letter-spacing: .04em; text-transform: uppercase; min-width: 0; }
.team.away { justify-content: flex-end; }
.dot { width: 14px; height: 14px; border-radius: 50%; flex: none; box-shadow: inset 0 0 0 2px rgba(255,255,255,.35); }
.score { font-family: var(--display); font-weight: 700; font-size: 34px; font-variant-numeric: tabular-nums; line-height: 1; display: flex; align-items: center; gap: 12px; }
.clock { font-size: 15px; color: var(--whistle); background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 3px 8px; letter-spacing: .06em; }
.meters { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr auto; gap: 16px; align-items: end; }
.meter-label .sh { display: none; }
.choices.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.sound { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 3px 10px; font-family: var(--display); font-size: 14px; letter-spacing: .04em; white-space: nowrap; }
.sound[aria-pressed="false"] { color: var(--muted); }
.choices.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.protest { border-color: var(--bad); }
.meter { display: grid; gap: 4px; }
.meter-label { display: flex; justify-content: space-between; font-family: var(--display); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.meter-label b { color: var(--chalk); font-weight: 600; font-variant-numeric: tabular-nums; }
.bar { height: 8px; background: var(--panel); border: 1px solid var(--line); border-radius: 99px; overflow: hidden; }
.bar > i { display: block; height: 100%; width: 70%; background: var(--good); transition: width .25s, background-color .25s; }

/* o relvado encolhe para caber no ecrã com o painel de decisão por baixo, sem scroll */
.stage { position: relative; width: 100%; width: min(100%, max(360px, calc((100vh - 300px) * 111 / 74))); width: min(100%, max(360px, calc((100dvh - 300px) * 111 / 74))); justify-self: center; aspect-ratio: 111 / 74; border-radius: 6px; overflow: hidden; background: #245f2f; box-shadow: 0 0 0 1px var(--line); touch-action: manipulation; }
.stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
#c3d { visibility: hidden; }
.stage.view3d #c3d { visibility: visible; }
.cap3d { position: absolute; left: 12px; top: 10px; right: 12px; display: flex; justify-content: space-between; gap: 8px; font-family: var(--display); font-size: 15px; letter-spacing: .05em; text-transform: uppercase; pointer-events: none; }
.cap3d span { background: rgba(10,16,12,.72); padding: 3px 8px; border-radius: 3px; }
.viewbtns { position: absolute; left: 50%; bottom: 58px; transform: translateX(-50%); display: flex; gap: 6px; }
.viewbtns button { background: rgba(10,16,12,.8); border: 1px solid var(--line); border-radius: 4px; padding: 5px 12px; font-family: var(--display); font-size: 15px; letter-spacing: .04em; white-space: nowrap; }
.viewbtns button[aria-pressed="true"] { background: var(--whistle); color: #1a1a0e; border-color: var(--whistle); }
.scrub { position: absolute; left: 8px; right: 8px; bottom: 8px; display: flex; align-items: center; gap: 6px; background: rgba(10,16,12,.8); border: 1px solid var(--line); border-radius: 6px; padding: 5px 8px; }
.scrub button { background: #1e2f24; border: 1px solid var(--line); border-radius: 4px; min-width: 34px; height: 30px; padding: 0 8px; font-family: var(--display); font-size: 15px; letter-spacing: .03em; white-space: nowrap; }
.scrub button:disabled, .scrub input:disabled { opacity: .4; cursor: default; }
.scrub .key { background: var(--whistle); color: #1a1a0e; border-color: var(--whistle); font-weight: 600; }
.track { position: relative; flex: 1; min-width: 60px; display: flex; align-items: center; }
.track input { width: 100%; margin: 0; accent-color: var(--whistle); }
.track i { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--whistle); pointer-events: none; }
.sctime { font-family: var(--display); font-size: 14px; font-variant-numeric: tabular-nums; color: var(--muted); min-width: 52px; text-align: right; }
.pip { position: absolute; right: 10px; bottom: 58px; width: 32%; aspect-ratio: 1.4; border: 2px solid rgba(238,240,230,.75); border-radius: 4px; pointer-events: none; box-shadow: 0 2px 12px rgba(0,0,0,.5); }
.pip.now { border-color: var(--whistle); }
.pip span { position: absolute; left: 0; top: 0; background: rgba(10,16,12,.8); padding: 2px 6px; font-family: var(--display); font-size: 13px; letter-spacing: .05em; text-transform: uppercase; }
.pip.now span { background: var(--whistle); color: #1a1a0e; }
.flash { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; font-family: var(--display); font-weight: 700; font-size: clamp(40px, 9vw, 96px); letter-spacing: .1em; color: var(--whistle); text-shadow: 0 4px 24px rgba(0,0,0,.6); }
.toast { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); background: rgba(10,16,12,.85); border: 1px solid var(--line); padding: 6px 12px; border-radius: 4px; font-family: var(--display); font-size: 17px; letter-spacing: .04em; white-space: nowrap; pointer-events: none; }

.overlay { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(8,14,10,.78); padding: 16px; overflow: auto; }
.card { max-width: 520px; display: grid; gap: 12px; }
.card h1 { margin: 0; font-family: var(--display); font-weight: 700; font-size: clamp(34px, 6vw, 54px); line-height: .95; letter-spacing: .02em; text-transform: uppercase; text-wrap: balance; }
.card h1 em { font-style: normal; color: var(--whistle); }
.card p { margin: 0; color: var(--muted); max-width: 60ch; }
.keys { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; font-size: 14px; }
.keys kbd { font-family: var(--display); font-size: 14px; background: var(--panel); border: 1px solid var(--line); border-radius: 3px; padding: 0 6px; color: var(--chalk); white-space: nowrap; }
.primary { justify-self: start; background: var(--whistle); color: #1a1a0e; border: 0; border-radius: 4px; padding: 10px 20px; font-family: var(--display); font-weight: 700; font-size: 20px; letter-spacing: .06em; text-transform: uppercase; }

.decide { display: grid; gap: 8px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 10px; }
.decide-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-family: var(--display); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-size: 14px; }
.timer { height: 4px; background: var(--line); border-radius: 99px; overflow: hidden; }
.timer > i { display: block; height: 100%; width: 100%; background: var(--whistle); }
.choices { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
#decide[data-kind="foul-box"] .choices { grid-template-columns: repeat(6, minmax(0, 1fr)); }
#decide[data-kind="offside"] .choices { grid-template-columns: repeat(3, minmax(0, 1fr)); }
#decide[data-kind="mao"] .choices, #decide[data-kind="canto"] .choices { grid-template-columns: repeat(4, minmax(0, 1fr)); }
#decide[data-kind="golo"] .choices, #decide[data-kind="linha"] .choices { grid-template-columns: repeat(3, minmax(0, 1fr)); }
#decide[data-kind="aereo"] .choices, #decide[data-kind="agarrao"] .choices { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.reds { display: inline-flex; gap: 3px; }
.reds i { display: inline-grid; place-items: center; width: 15px; height: 20px; border-radius: 2px; background: #d8322f; color: #fff; font-style: normal; font-size: 12px; font-weight: 700; box-shadow: 0 1px 3px rgba(0,0,0,.4); }
.radio { position: absolute; left: 10px; bottom: 56px; max-width: min(420px, 80%); background: rgba(8,14,10,.88); border: 1px solid #39d0ff; border-radius: 6px; padding: 6px 10px; font-size: 14px; color: var(--chalk); pointer-events: none; display: grid; gap: 1px; }
.radio b { font-family: var(--display); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #39d0ff; }
.radio b::before { content: "◉ "; }
.radio.fresh { animation: rin .25s ease-out; }
@keyframes rin { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
.say { position: absolute; left: 50%; top: 44px; transform: translateX(-50%); width: max-content; max-width: min(560px, 86%); background: #f7f7f2; color: #15161a; padding: 8px 14px; border-radius: 14px; font-size: 15px; font-weight: 600; line-height: 1.3; text-align: center; box-shadow: 0 4px 18px rgba(0,0,0,.45); pointer-events: none; }
.say::after { content: ""; position: absolute; left: 50%; bottom: -8px; margin-left: -8px; border: 8px solid transparent; border-bottom: 0; border-top-color: #f7f7f2; }
.paper { background: #f1ece0; color: #1d1d1b; border-radius: 4px; padding: 12px 14px; display: grid; gap: 5px; font-family: Georgia, "Times New Roman", serif; }
.paper .pname { display: flex; justify-content: space-between; gap: 8px; font-family: var(--display); font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: #6b5f45; border-bottom: 1px solid #cfc6b0; padding-bottom: 4px; }
.paper .pname b { color: #b5452c; letter-spacing: .08em; }
.paper h3 { margin: 0; font-size: 21px; line-height: 1.15; text-wrap: balance; }
.paper p { margin: 0; font-size: 14px; color: #3a3a36; }
.paper .quote { font-style: italic; }
tr.me td { color: var(--whistle); font-weight: 600; }
.papers { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 14px; }
.papers small { display: block; color: var(--muted); font-size: 12px; }
.ask { border-color: var(--whistle); }
.ticker { position: absolute; left: 10px; top: 10px; max-width: 70%; background: rgba(8,14,10,.72); border-left: 3px solid var(--whistle); padding: 4px 10px; font-size: 13px; color: var(--chalk); border-radius: 2px; pointer-events: none; opacity: .9; }
.ticker.fresh { animation: tick 6s forwards; }
@keyframes tick { 0% { opacity: 0; transform: translateY(-4px); } 6% { opacity: .95; transform: none; } 80% { opacity: .95; } 100% { opacity: .35; } }
.stage.view3d .ticker { display: none; }
.summary { margin: 4px 0 14px; }
.summary h3 { margin: 0 0 6px; font-family: var(--display); font-size: 16px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
.moments { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; font-size: 14px; }
.moments b { display: inline-block; min-width: 44px; color: var(--whistle); font-family: var(--display); font-variant-numeric: tabular-nums; }
.moments .k-goal { color: var(--chalk); font-weight: 600; }
.moments .k-card b { color: var(--whistle); }
.moments .k-var b, .moments .k-pen b { color: #39d0ff; }
details.feed { margin-top: 8px; }
details.feed summary { cursor: pointer; color: var(--muted); font-size: 13px; }
details.feed .moments { margin-top: 6px; max-height: 260px; overflow: auto; font-size: 13px; color: var(--muted); }
.choice { background: #1e2f24; border: 1px solid var(--line); border-radius: 4px; padding: 8px 4px; display: grid; justify-items: center; gap: 2px; font-family: var(--display); font-weight: 600; font-size: 17px; letter-spacing: .03em; }
.choice small { font-family: var(--body); font-weight: 500; font-size: 11px; color: var(--muted); }
.choice:hover { border-color: var(--muted); }
.choice .swatch { width: 14px; height: 19px; border-radius: 2px; }
.choice.ghost { background: transparent; }
.choice:disabled { opacity: .45; cursor: default; }

.help { margin: 0; color: var(--muted); font-size: 13px; }
.review { display: grid; gap: 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 16px; }
.review h2 { margin: 0; font-family: var(--display); font-size: 26px; letter-spacing: .03em; text-transform: uppercase; }
.grade { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
.grade b { font-family: var(--display); font-size: 56px; line-height: 1; color: var(--whistle); font-variant-numeric: tabular-nums; }
.grade span { color: var(--muted); }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 14px; font-variant-numeric: tabular-nums; }
th { text-align: left; font-family: var(--display); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-size: 13px; padding: 6px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
td { padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
td.ok { color: var(--good); font-weight: 600; }
td.half { color: var(--whistle); font-weight: 600; }
td.bad { color: var(--bad); font-weight: 600; }
.linkbtn { background: none; border: 1px solid var(--line); border-radius: 3px; padding: 2px 8px; font-size: 13px; white-space: nowrap; }
.ghostbtn { background: transparent; border: 1px solid var(--whistle); color: var(--whistle); border-radius: 4px; padding: 10px 18px; font-family: var(--display); font-weight: 600; font-size: 18px; letter-spacing: .05em; text-transform: uppercase; }
.row-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.small { margin: 0; color: var(--muted); font-size: 13px; }
.kicker { font-family: var(--display); font-size: 15px; letter-spacing: .08em; text-transform: uppercase; color: var(--whistle); }
.card h1.teams { font-size: clamp(26px, 4.6vw, 44px); }
.story { margin: 0; padding-left: 18px; color: var(--chalk); display: grid; gap: 4px; }
.story.below { display: none; }
.news { margin: 0; background: #1e2f24; border-left: 3px solid var(--whistle); padding: 8px 12px; border-radius: 3px; }
.car-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.car-head span { font-family: var(--display); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.career h3 { margin: 0 0 6px; font-family: var(--display); font-size: 18px; letter-spacing: .05em; text-transform: uppercase; }
.ladder { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; }
.ladder li { text-align: center; font-family: var(--display); font-size: 14px; letter-spacing: .03em; padding: 6px 2px; border: 1px solid var(--line); border-radius: 3px; color: var(--muted); }
.ladder li.past { color: var(--chalk); }
.ladder li.on { background: var(--whistle); color: #1a1a0e; border-color: var(--whistle); font-weight: 600; }
.car-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; }
td.next { color: var(--whistle); }
.attr { display: grid; grid-template-columns: 1fr auto auto; gap: 10px; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--line); }
.attr b { display: block; font-weight: 600; }
.attr small { color: var(--muted); font-size: 12px; }
.pips { display: flex; gap: 2px; }
.pips i { width: 7px; height: 14px; background: var(--line); border-radius: 1px; }
.pips i.on { background: var(--good); }
.linkbtn:disabled { opacity: .4; cursor: default; }

@media (max-width: 640px) {
  .meters { grid-template-columns: repeat(4, minmax(0, 1fr)) auto; gap: 8px; }
  .meter-label { font-size: 10px; letter-spacing: .02em; }
  .meter-label b { display: none; }
  .meter-label .lg { display: none; }
  .meter-label .sh { display: inline; }
  .sound { font-size: 0; width: 30px; height: 26px; padding: 0; }
  .sound::before { content: '♪'; font-size: 15px; }
  .sound[aria-pressed="false"] { text-decoration: line-through; }
  .sound[aria-pressed="false"]::before { content: '♪̸'; }
  .choices.four { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; }
  .choices.four .choice { font-size: 14px; padding: 6px 2px; }
  .choices.four .choice small { font-size: 10px; }
  .choices.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .scrub { gap: 4px; padding: 4px 6px; }
  .scrub button { min-width: 28px; height: 28px; padding: 0 6px; font-size: 13px; }
  .sctime { display: none; }
  .viewbtns { bottom: 50px; }
  .pip { width: 40%; bottom: 50px; }
  .viewbtns button { padding: 4px 8px; font-size: 13px; }
  .choices { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  #decide[data-kind="foul-box"] .choices { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .choices .choice { font-size: 13px; letter-spacing: 0; padding: 6px 2px; min-width: 0; }
  .choices .choice small { font-size: 10px; }
  .ticker { font-size: 11px; max-width: 85%; top: 6px; left: 6px; }
  .team { font-size: 13px; line-height: 1.1; gap: 6px; }
  .team span:not(.dot) { overflow-wrap: anywhere; }
  .team { position: relative; }
  .reds { position: absolute; top: calc(100% + 2px); left: 0; gap: 1px; } .team.away .reds { left: auto; right: 0; } .reds i { width: 10px; height: 14px; font-size: 9px; }
  .reds:empty { display: none; }
  .score { font-size: 26px; }
  .cap3d { font-size: 12px; }
  .ladder { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .car-grid { grid-template-columns: 1fr; }
  #brief { padding: 10px 12px; place-items: start stretch; }
  #brief .card { gap: 5px; }
  #brief .kicker { font-size: 13px; }
  .card h1.teams { font-size: 21px; }
  #brief .story { display: none; }
  .story.below { display: grid; }
  #brief .primary { padding: 6px 14px; font-size: 16px; }
}
</style>

<div class="wrap">
  <header class="hud">
    <div class="team"><span class="dot" id="hd0" style="background: var(--blue)"></span><span id="hn0">Azuis</span><span class="reds" id="rc0"></span></div>
    <div class="score"><span id="s0">0</span><span class="clock" id="clock">0'</span><span id="s1">0</span></div>
    <div class="team away"><span class="reds" id="rc1"></span><span id="hn1">Laranjas</span><span class="dot" id="hd1" style="background: var(--orange)"></span></div>
  </header>
  <div class="meters">
    <div class="meter"><div class="meter-label"><span><span class="lg">Controlo do jogo</span><span class="sh">Controlo</span></span><b id="ctrlTxt">70</b></div><div class="bar"><i id="ctrlBar"></i></div></div>
    <div class="meter"><div class="meter-label"><span>Energia</span><b id="staTxt">100</b></div><div class="bar"><i id="staBar" style="background: var(--whistle)"></i></div></div>
    <div class="meter"><div class="meter-label"><span><span class="lg">Pressão do público</span><span class="sh">Público</span></span><b id="crowdTxt">35</b></div><div class="bar"><i id="crowdBar" style="width: 35%; background: var(--muted)"></i></div></div>
    <div class="meter"><div class="meter-label"><span>Nervos</span><b id="stTxt">15</b></div><div class="bar"><i id="stBar" style="width: 15%"></i></div></div>
    <button class="sound" type="button" id="soundBtn" aria-pressed="true">Som ligado</button>
  </div>

  <div class="stage" id="stage">
    <canvas id="c2d"></canvas>
    <canvas id="c3d"></canvas>
    <div class="cap3d" id="cap3d" hidden><span id="capL"></span><span id="capR"></span></div>
    <div class="flash" id="flash" hidden>Lance!</div>
    <div class="toast" id="toast" hidden></div>
    <div class="ticker" id="ticker" hidden></div>
    <div class="say" id="refSay" hidden></div>
    <div class="radio" id="radio" hidden><b id="radioWho"></b><span id="radioTxt"></span></div>
    <div class="viewbtns" id="viewBtns" hidden>
      <button type="button" id="viewMine" aria-pressed="false">A tua vista</button>
      <button type="button" id="viewIdeal" aria-pressed="true">Vista ideal</button>
      <button type="button" id="viewClose">Fechar</button>
    </div>
    <div class="pip" id="pip" hidden><span id="pipTxt">Passe</span></div>
    <div class="scrub" id="scrub" hidden>
      <button type="button" id="scPlay" aria-label="Pausa">❚❚</button>
      <button type="button" id="scBack" aria-label="Recuar um fotograma">‹</button>
      <div class="track"><input type="range" id="scRange" min="0" max="1000" step="1" value="0" aria-label="Linha do tempo do lance"><i id="scMark"></i></div>
      <button type="button" id="scFwd" aria-label="Avançar um fotograma">›</button>
      <button type="button" class="key" id="scKey">Duelo</button>
      <button type="button" id="scSpeed" aria-label="Velocidade">1x</button>
      <span class="sctime" id="scTime"></span>
    </div>
    <div class="overlay" id="brief" hidden>
      <div class="card">
        <span class="kicker" id="briefComp"></span>
        <h1 class="teams" id="briefTeams"></h1>
        <ul class="story" id="briefLines"></ul>
        <button class="primary" id="briefStart" type="button">Apitar o início</button>
      </div>
    </div>
    <div class="overlay" id="menu">
      <div class="card">
        <h1>Árbitro de <em>Caricas</em></h1>
        <p>Onze contra onze, cinco minutos. Segue o jogo com a tua carica preta e amarela. Quando houver um lance, vês o momento em 3D a partir do sítio onde estás: se estiveres longe ou tapado, vês pior. Nos foras de jogo apertados vês o passe pelos olhos do assistente. Os Azuis jogam em casa: o público pressiona, os jogadores protestam e o VAR chama-te ao monitor quando erras num lance grave.</p>
        <div class="keys">
          <kbd>WASD / setas</kbd><span>mover o árbitro (ou toca no campo)</span>
          <kbd>Shift</kbd><span>correr, gasta energia</span>
          <kbd>1 a 6</kbd><span>siga, falta, amarelo, vermelho, simulação, vantagem</span>
          <kbd>1 a 3</kbd><span>mão na bola e cantos: siga, penálti ou livre, e a variante com cartão</span>
          <kbd>1 / 2</kbd><span>no fora de jogo e nos golos: em jogo ou fora, golo válido ou anulado, entrou ou não</span>
          <kbd>R</kbd><span>rever o lance em câmara lenta</span>
          <kbd>1 a 4</kbd><span>nos protestos: ignorar, afastar, amarelo, falar com o capitão</span>
          <kbd>Espaço , .</kbd><span>depois de veres o lance: pausa e fotograma a fotograma</span>
        </div>
        <div class="row-actions"><button class="primary" id="startBtn" type="button">Apitar o início</button><button class="ghostbtn" id="careerBtn" type="button">Carreira</button><button class="ghostbtn" id="trainBtn" type="button">Treinar o VAR</button><button class="ghostbtn" id="installBtn" type="button" hidden>Instalar a app</button></div>
        <p class="small">Na carreira começas nos distritais e o observador decide se sobes, ficas ou desces no fim de cada época, até à final do Mundial.</p>
      </div>
    </div>
  </div>

  <section class="decide" id="decide" hidden>
    <div class="decide-top"><span id="decideMsg">Qual é a tua decisão?</span><span id="decideTime"></span></div>
    <div class="timer"><i id="timerBar"></i></div>
    <div class="choices">
      <button class="choice" type="button" data-k="foul mao canto aereo agarrao" data-d="siga">Siga<small>1 · lance limpo</small></button>
      <button class="choice" type="button" data-k="foul aereo agarrao" data-d="falta">Falta<small id="faltaSmall">2 · livre</small></button>
      <button class="choice" type="button" data-k="foul aereo agarrao" data-d="amarelo"><span class="swatch" style="background: var(--whistle)"></span>Amarelo<small>3</small></button>
      <button class="choice" type="button" data-k="foul aereo agarrao" data-d="vermelho"><span class="swatch" style="background: var(--bad)"></span>Vermelho<small>4</small></button>
      <button class="choice" type="button" data-k="foul" data-d="simulacao">Simulação<small>5 · amarelo ao atacante</small></button>
      <button class="choice" type="button" data-k="foul" data-d="vantagem">Vantagem<small>6 · deixa seguir</small></button>
      <button class="choice" type="button" data-k="offside" data-d="emjogo" hidden>Em jogo<small id="ojSmall">1 · segue o ataque</small></button>
      <button class="choice" type="button" data-k="offside" data-d="fora" hidden><span class="swatch" style="background: var(--whistle)"></span>Fora de jogo<small id="foraSmall">2 · livre indireto</small></button>
      <button class="choice" type="button" data-k="mao" data-d="mao" hidden>Mão<small id="maoSmall">2 · penálti</small></button>
      <button class="choice" type="button" data-k="mao" data-d="maoAmarelo" hidden><span class="swatch" style="background: var(--whistle)"></span>Mão + amarelo<small>3 · deliberada</small></button>
      <button class="choice" type="button" data-k="canto" data-d="penalti" hidden>Penálti<small>2 · falta do defesa</small></button>
      <button class="choice" type="button" data-k="canto" data-d="ataque" hidden>Falta atacante<small>3 · livre para a defesa</small></button>
      <button class="choice" type="button" data-k="golo" data-d="valido" hidden>Golo válido<small>1 · ombro com ombro</small></button>
      <button class="choice" type="button" data-k="golo" data-d="anular" hidden>Anular<small>2 · falta do atacante</small></button>
      <button class="choice" type="button" data-k="linha" data-d="entrou" hidden>Golo<small>1 · entrou toda</small></button>
      <button class="choice" type="button" data-k="linha" data-d="naoEntrou" hidden>Não entrou<small>2 · siga o jogo</small></button>
      <button class="choice ghost" type="button" id="replayBtn">Rever<small>R · câmara lenta</small></button>
    </div>
  </section>

  <section class="decide protest" id="protest" hidden>
    <div class="decide-top"><span id="protestMsg">Protestos</span><span>Intensidade</span></div>
    <div class="timer"><i id="protestBar" style="background: var(--bad)"></i></div>
    <div class="choices four">
      <button class="choice" type="button" id="pIgnore">Ignorar<small>1 · deixa falar</small></button>
      <button class="choice" type="button" id="pAway">Afastar<small>2 · gesto firme</small></button>
      <button class="choice" type="button" id="pCard"><span class="swatch" style="background: var(--whistle)"></span>Amarelo<small>3 · por protestos</small></button>
      <button class="choice" type="button" id="pCap"><span class="swatch" style="background: #f2cf3a; border-radius: 2px; height: 4px"></span>Capitão<small id="pCapT">4 · confiança</small></button>
    </div>
  </section>

  <section class="decide ask" id="ask" hidden>
    <div class="decide-top"><span id="askMsg"></span><span id="askTag"></span></div>
    <div class="timer"><i id="askBar" style="background: var(--whistle)"></i></div>
    <div class="choices three" id="askChoices"></div>
  </section>

  <p class="help" id="help">O observador avalia cada decisão contra o que aconteceu de facto. No monitor do VAR, num fora de jogo, arrasta as duas linhas no relvado até às partes do corpo que contam (setas para afinar, Tab troca de linha). Erros baixam o controlo do jogo e deixam os jogadores mais nervosos; abaixo de 10 o jogo é interrompido.</p>

  <section class="review career" id="career" hidden>
    <div class="car-head"><h2>Carreira</h2><span id="carSeason"></span></div>
    <p class="news" id="carNews" hidden></p>
    <ul class="story below" id="carStory"></ul>
    <ol class="ladder" id="carLadder" aria-label="Escalões"></ol>
    <div class="car-grid">
      <div>
        <h3>Jogos da época</h3>
        <table><thead><tr><th>Jogo</th><th>Equipas</th><th>Nota</th></tr></thead><tbody id="carFix"></tbody></table>
      </div>
      <div>
        <h3>O teu árbitro</h3>
        <p class="small" id="carPts"></p>
        <div id="carAttrs"></div>
        <p class="small" id="carFinals" hidden></p>
      </div>
    </div>
    <div class="car-grid">
      <div id="carRank">
        <h3>Classificação dos árbitros</h3>
        <table><thead><tr><th>#</th><th>Árbitro</th><th>Jogos</th><th>Média</th></tr></thead><tbody id="carTable"></tbody></table>
      </div>
      <div id="carPapersWrap" hidden>
        <h3>Nos jornais</h3>
        <ul class="papers" id="carPapers"></ul>
      </div>
    </div>
    <div class="row-actions"><button class="ghostbtn" id="carMenu" type="button">Menu</button><button class="linkbtn" id="carReset" type="button">Apagar carreira</button></div>
  </section>

  <section class="review" id="review" hidden>
    <h2 id="revTitle">Relatório do observador</h2>
    <div class="grade"><b id="grade">0.0</b><span id="gradeTxt"></span></div>
    <p class="news" id="careerNote" hidden></p>
    <div class="paper" id="paper" hidden><div class="pname"><span id="paperName"></span><b id="paperStars"></b></div><h3 id="paperHead"></h3><p id="paperBody"></p><p class="quote" id="paperQuote"></p></div>
    <div class="summary"><h3>Momentos do jogo</h3><ol class="moments" id="sumList"></ol>
      <details class="feed"><summary>Relato completo · <span id="feedCount"></span></summary><ol class="moments" id="feedList"></ol></details></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Min.</th><th>O que foi</th><th>Decidiste</th><th>Viste de</th><th>Avaliação</th><th></th></tr></thead>
        <tbody id="revBody"></tbody>
      </table>
    </div>
    <div class="row-actions"><button class="primary" id="againBtn" type="button">Jogar outra vez</button></div>
  </section>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
